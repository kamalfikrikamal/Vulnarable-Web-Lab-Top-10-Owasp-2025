-- db_backup_2024.sql.bak
-- Dump database production "shop_prod" - dibuat oleh cron backup harian.
-- File ini seharusnya disimpan di luar webroot / storage terenkripsi,
-- BUKAN di dalam folder yang bisa diakses lewat HTTP.

CREATE TABLE users (
  id INT PRIMARY KEY AUTO_INCREMENT,
  username VARCHAR(50),
  password VARCHAR(255),
  email VARCHAR(100),
  role VARCHAR(20)
);

